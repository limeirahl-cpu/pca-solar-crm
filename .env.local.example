NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Opcional — ativa a geração de legendas por IA em Marketing > Criativos.
# Sem esta variável, a interface mostra "IA não configurada" (não trava nada).
ANTHROPIC_API_KEY=

# Opcionais — ativam o teste de conexão em Admin > Integrações (WhatsApp Business API
# e Instagram Graph API, via Meta for Developers). Sem elas, cada integração aparece
# como "não configurada". Publicação/envio automático ainda não está implementado —
# só o teste de conexão (leitura), que depende dessas credenciais.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
